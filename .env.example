# Waffled settings. Everything here is optional: `docker compose up -d` works with no
# .env at all. To change a setting, copy this file to .env (next to compose.yaml),
# uncomment the line, and run `docker compose up -d` again.

# ── Basics ──────────────────────────────────────────────────────────────────
# HTTP_PORT=8080                 # host port the app is published on
# WAFFLED_VERSION=latest         # image tag to run (pin a release, e.g. 0.16.0)
# TZ=UTC                         # container timezone (also the backup schedule's)

# ── Postgres ────────────────────────────────────────────────────────────────
# Postgres is never published to the host, so the default password is only reachable
# from inside the compose network. Set these BEFORE the first start; changing them
# later does not change an existing database. Use URL-safe characters.
# POSTGRES_USER=waffled
# POSTGRES_PASSWORD=waffled
# POSTGRES_DB=waffled

# ── Reverse proxy / public address ──────────────────────────────────────────
# The public origin used for OAuth redirect URLs (OIDC sign-in, calendar connects).
# Set it when you reach Waffled through a hostname rather than localhost.
# PUBLIC_BASE_URL=https://waffled.example.com
# Trust X-Forwarded-* headers. Only set this when Waffled sits behind a reverse proxy
# you control (Caddy, nginx, Traefik, a tunnel); otherwise clients could spoof them.
# TRUST_PROXY=true

# ── Secrets (generated automatically) ───────────────────────────────────────
# On first start the app writes these to /data/secrets.json in the waffled_data
# volume and reuses them. A value set here wins over the generated one.
# LOCAL_JWT_SECRET=              # signs login sessions (openssl rand -base64 48)
# TOKEN_ENCRYPTION_KEY=          # encrypts stored OAuth tokens (openssl rand -base64 32)

# ── Sessions and rate limits (defaults shown) ───────────────────────────────
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=60
# AUTH_FORCE_PASSWORD=1          # break-glass: always show the password form
# RATE_LIMIT_SETUP_MAX=5
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# RATE_LIMIT_LOGIN_IP_MAX=50
# RATE_LIMIT_OIDC_START_MAX=30
# RATE_LIMIT_OIDC_EXCHANGE_MAX=20
# RATE_LIMIT_REFRESH_MAX=60
# RATE_LIMIT_KIOSK_PAIR_MAX=10
# RATE_LIMIT_KIOSK_TOKEN_MAX=30
# RATE_LIMIT_MEDIA_MAX=30

# ── AI capture bar (set any subset; pick the active one in Settings) ────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1   # any OpenAI-compatible server
# OLLAMA_HOST=http://host.docker.internal:11434         # Linux: http://172.17.0.1:11434
# OLLAMA_MODEL=llama3.1

# ── Google Calendar two-way sync ────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/auth/google/calendar/callback
# GOOGLE_CALENDAR_SCOPES=openid email https://www.googleapis.com/auth/calendar

# ── Outlook / Microsoft 365 two-way sync ────────────────────────────────────
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_CALENDAR_REDIRECT_URI=http://localhost:8080/auth/microsoft/calendar/callback
# MS_CALENDAR_SCOPES=openid email offline_access User.Read Calendars.ReadWrite

# ── Backups (off by default) ────────────────────────────────────────────────
# Start the backup service with: docker compose --profile backup up -d
# and set BACKUP_ENABLED=true so System Health expects (and checks) a recent backup.
# Run one now:   docker compose exec backup waffled-backup
# Restore:       docker compose stop waffled
#                docker compose run --rm --no-deps backup restore <file.sql.gz>
#                docker compose start waffled
# BACKUP_ENABLED=true
# BACKUP_TIME=02:00              # daily HH:MM in TZ
# BACKUP_RETENTION_DAYS=14       # delete local dumps older than this
# BACKUP_ON_START=false          # also back up right after the service starts
# BACKUP_INCLUDE_MEDIA=false     # also archive uploaded media
# BACKUP_HOST_PATH=/mnt/backups  # write dumps to a host folder instead of the volume
# Optional offsite copy to S3 / Backblaze B2 / Cloudflare R2 / MinIO:
# BACKUP_S3_BUCKET=s3://my-bucket/waffled
# BACKUP_S3_ENDPOINT=            # set for B2/R2/MinIO; empty means AWS
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# ── Observability and logs ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # unset = OpenTelemetry off
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=waffled
# LOG_FORMAT=json                # json | pretty
# LOG_LEVEL=info

# ── Update notifier ─────────────────────────────────────────────────────────
# UPDATE_CHECK_REPO=evan-ribbey/waffled-ng   # GitHub repo checked for new releases
# UPDATE_CHECK_ENABLED=false                 # turn the check off entirely
