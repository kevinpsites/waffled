# Site address comes from the environment so the same file works locally (":80")
# and on the tailnet/prod (a hostname → Caddy auto-provisions TLS).
{$CADDY_SITE_ADDRESS} {
	encode gzip

	# health check
	respond /healthz "ok" 200

	# API (chunk 2.2). Path is preserved upstream, so the api sees /api/*.
	handle /api/* {
		reverse_proxy api:3000 {
			# Replace caller-supplied forwarding chains with the address Caddy saw. The
			# api builds the PowerSync endpoint and the OIDC redirect URL out of Host and
			# Proto, so a caller must not get to dictate them. caddy:2 already overwrites
			# both (nothing is trusted until trusted_proxies says so) — this pins it to
			# our config instead of the floating base image's default.
			# {hostport} keeps the port, matching Caddy's own default: oidc.ts uses the
			# value verbatim, and {host} would strip it on every non-:80 install.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {hostport}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# Google's browser callback is intentionally outside /api, but still enters
	# through the same public proxy instead of the loopback-only direct API port.
	handle /auth/google/* {
		reverse_proxy api:3000
	}

	# Uploaded family media. API responses contain short-lived HMAC-signed URLs; Caddy
	# asks the API to validate each URL before reading the file from its read-only volume.
	# The route then strips /media, mapping the safe storage key under /data/media.
	handle /media/* {
		route {
			# `route` preserves this order: validation sees the original /media URI,
			# then the prefix is stripped only for the local file lookup.
			forward_auth api:3000 {
				uri /api/media/authorize
			}
			uri strip_prefix /media
			root * /data/media
			header Cache-Control "private, max-age=300, no-transform"
			header X-Content-Type-Options "nosniff"
			file_server
		}
	}

	# the web SPA (built into this image from apps/web); SPA fallback to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# PowerSync keeps a separate client-facing port, but Caddy owns the public socket
# so hostname mode gets TLS and the PowerSync service stays on the Compose network.
{$POWERSYNC_CADDY_ADDRESS} {
	encode gzip
	reverse_proxy powersync:8080
}
